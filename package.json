{
  "name": "codex-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An infinite design canvas and MCP plugin for ChatGPT and Codex",
  "scripts": {
    "predev": "node scripts/build-shaders.mjs && node scripts/build-diagrams.mjs",
    "dev": "tsx server/index.ts",
    "prebuild": "node scripts/build-shaders.mjs && node scripts/build-diagrams.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-widget.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "premcp": "node scripts/build-shaders.mjs && node scripts/build-diagrams.mjs",
    "mcp": "tsx server/stdio.ts",
    "mcp:browser": "node dist/browser.mjs",
    "typecheck": "tsc --noEmit",
    "package:plugin": "node scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "codemirror": "6.0.2",
    "elkjs": "0.12.0",
    "esbuild-wasm": "0.25.12",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shaders": "4.0.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "tronschell"
}
