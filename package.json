{
  "name": "codex-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An infinite design canvas and MCP plugin for ChatGPT and Codex",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-widget.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "mcp": "tsx server/stdio.ts",
    "mcp:browser": "node dist/browser.mjs",
    "typecheck": "tsc --noEmit",
    "package:plugin": "node scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0",
    "@babel/parser": "7.29.9"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
